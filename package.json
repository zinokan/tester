{
  "name": "zenni-dating-app",
  "version": "1.0.0",
  "description": "Location-based social discovery and dating application",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm start",
    "mobile": "cd mobile && npm start",
    "build": "cd client && npm run build",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "setup": "npm install && cd server && npm install && cd ../client && npm install && cd ../mobile && npm install"
  },
  "keywords": ["dating", "social", "mobile", "react", "node"],
  "author": "Zenni Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0"
  }
}